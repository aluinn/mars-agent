{
  "name": "mars-agent",
  "private": true,
  "version": "0.1.0",
  "description": "Autonomous rover agent simulation on real Jezero Crater terrain: mast-camera perception, slope-aware navigation, habitability scoring and an Earth downlink.",
  "license": "MIT",
  "author": "Aluinn McDonald",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aluinn/mars-agent.git"
  },
  "homepage": "https://mars-agent-blond.vercel.app",
  "bugs": {
    "url": "https://github.com/aluinn/mars-agent/issues"
  },
  "keywords": [
    "mars",
    "jezero-crater",
    "rover",
    "simulation",
    "autonomous-agents",
    "threejs",
    "typescript",
    "vite",
    "pathfinding",
    "computer-vision"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "bench": "node scripts/benchmark.mjs",
    "format": "prettier --write",
    "train": "node scripts/train_detector.mjs"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/three": "^0.187.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
